# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Hostinger SMTP Configuration for Email Notifications
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@snelkrediet.eu"
SMTP_PASS="YOUR_HOSTINGER_MAIL_PASSWORD"
SMTP_FROM="Snel Krediet <contact@snelkrediet.eu>"
NOTIFICATION_EMAIL="contact@snelkrediet.eu"
